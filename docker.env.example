# Copia este archivo a `.env` (raíz del repo) y completa los secretos.
# `docker compose up -d --build` lee automáticamente `.env`.
# Genera secretos con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── MySQL 8 ────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=empleonow
MYSQL_USER=empleonow
MYSQL_PASSWORD=change-me-app

# ── API ────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-32-chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-32-chars-minimum
DATA_ENCRYPTION_KEY=change-me-data-encryption-key-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Origen exacto del frontend (sin slash final). En producción:
# CLIENT_ORIGIN=https://empleonow.com
CLIENT_ORIGIN=http://localhost:8080

# ── Frontend build ─────────────────────────────────────────────────────────
VITE_TURNSTILE_SITE_KEY=
WEB_PORT=8080

# ── Anti-bots (Cloudflare Turnstile) ───────────────────────────────────────
# Sin secreto el backend opera en modo bypass (solo desarrollo).
TURNSTILE_SECRET_KEY=

# ── Almacenamiento S3 (opcional; sin esto se usa disco local) ──────────────
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Correo (opcional; SendGrid o SMTP; sin esto solo loguea) ───────────────
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EmpleoNow <no-reply@empleonow.com>
