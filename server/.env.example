# Backend - variables de entorno (copiar a .env y completar)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/empleonow"
PORT=3000
CLIENT_ORIGIN="http://localhost:5173"
JWT_ACCESS_SECRET="change-me-secret-1"
JWT_REFRESH_SECRET="change-me-secret-2"
